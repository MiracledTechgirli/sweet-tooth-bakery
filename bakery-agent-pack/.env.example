# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never expose

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mailgun ──
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandboxXXXX.mailgun.org
MAILGUN_API_BASE=https://api.mailgun.net   # EU: https://api.eu.mailgun.net
MAILGUN_FROM="Golden Crumb Bakery <orders@sandboxXXXX.mailgun.org>"
OWNER_NOTIFY_EMAIL=

# Google OAuth client ID/secret are entered in the Supabase dashboard (Auth > Providers > Google),
# not in this file. See docs/AUTH_GOOGLE_SETUP.md.
